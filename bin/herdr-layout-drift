#!/bin/sh
# After a Herdr app update: has Herdr's shipped `main` layout changed since the
# `main-sideshow` copy was made (task-46-15)? Herdr rewrites layouts/main.json on
# every start, so it is always the shipped one.
#   no output, exit 0: nothing to do.
#   a diff, exit 1: remake the copy from the new shipped file (it also updates the base):
#     herdr-app/sideshow/layout/apply.py
#   then check the window with herdr-app status / shot.
set -eu
repo=$(cd "$(dirname "$0")/.." && pwd)
base=$repo/herdr-app/sideshow/layout/main.base.json
shipped=${HERDR_APP_HOME:-$HOME/.config/herdr-app}/layouts/main.json
[ -f "$shipped" ] || { echo "no shipped layout at $shipped" >&2; exit 2; }
diff -u "$base" "$shipped"
